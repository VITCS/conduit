# Go build output
/conduitd
/dist/

# Node / Next.js
web/node_modules/
web/.next/

# Playwright e2e output
web/test-results/
web/playwright-report/
web/.playwright/

# Next.js static export — generated by `make ui` (`next build`). It is rebuilt
# from source, so we don't track the output, but we keep a placeholder so the
# `//go:embed all:web/out` directive still compiles on a fresh clone. Run
# `make ui` to populate the real UI before running the server.
web/out/*
!web/out/.gitkeep

# Local env / editor
.env
.env.local
*.local
.DS_Store
